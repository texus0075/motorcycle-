rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Catalog Collections (Public Read, Authenticated Write)
    match /brands/{brandId} {
      allow read: if true;
      allow write: if true; // allow initial seeding and sync
    }

    match /motorcycles/{bikeId} {
      allow read: if true;
      allow write: if true;

      // Real user community reviews
      match /reviews/{reviewId} {
        allow read: if true;
        allow create, update: if request.auth != null;
        allow delete: if request.auth != null && (request.auth.uid == resource.data.userId);
      }
    }

    match /variants/{variantId} {
      allow read: if true;
      allow write: if true;
    }

    // 2. User Data & Cloud Garage Backup (Only the owner can access)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /favorites/{favId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /comparisons/{compId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Fallback rule
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
